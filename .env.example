# .env.example

# Supabase (client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-pk

# Supabase (server/admin)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Lovable / platform flags
# ENABLE_STRIPE_PAYMENTS=1

# Any other keys used by the project
# e.g. third-party integrations, analytics, feature flags
# SENTRY_DSN=
